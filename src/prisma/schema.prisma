generator client {
    provider = "prisma-client-js"
}

model User{
    id String @id @default(uuid())
    email String @unique
    name String 
    password String
    slug String @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    schedules Schedule[]
    appointments Appointment[]

    @@map("users")
}

model Schedule {
    id String @id @default(uuid())
    weekDay Int 
    timeStartInMinutes Int
    timeEndInMinutes Int

    userId String
    user User @relation(fields: [userId], references: [id], onDelete: Cascade) 

    @@index([userId, weekDay])
    @@map("schedules")
}

model Appointment{
    id String @id @default(uuid())
    date DateTime 
    customerName String
    customerPhone String
    status String @default("PENDING")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("appointments")
}

datasource db{
    provider = "sqlite"
}

